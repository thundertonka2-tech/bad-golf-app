<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera for the AR measure screen. Asked for only when someone taps Measure. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- required="false" everywhere: phones without a camera or without ARCore still
         install Bad Golf from Play; they just never see the Measure button. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application>
        <!-- "AR Optional" app: Play does not force-install Google Play Services for AR.
             The measure screen asks for it the first time it's needed. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".MeasureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
